{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/portfolio/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/portfolio/api/(.*)", "dest": "/api/$1" },
    { "src": "/portfolio/(globe\\.svg|IHK-logo\\.svg|Pentool\\.svg|VideoCut\\.svg|favicon\\.png|IMAGE_002\\.jpg)", "dest": "/$1" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/Favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}